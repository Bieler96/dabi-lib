{
	"name": "dabi-lib",
	"version": "1.6.0",
	"description": "A modern React component library and CLI for fast project generation.",
	"bin": {
		"dabi": "./bin/dabi.ts"
	},
	"type": "module",
	"engines": {
		"node": ">=20.19"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./style.css": "./dist/index.css"
	},
	"peerDependencies": {
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"files": [
		"dist",
		"bin",
		"README.md",
		"CLI_README.md"
	],
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build --config vite.config.lib.ts",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"lint": "eslint .",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"preview": "vite preview",
		"update-package": "npm run build && npm publish",
		"patch": "npm version patch && npm run update-package",
		"minor": "npm version minor && npm run update-package",
		"major": "npm version major && npm run update-package"
	},
	"dependencies": {
		"@base-ui/react": "^1.5.0",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@floating-ui/react": "^0.27.14",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-router": "^1.170.11",
		"@tanstack/react-table": "^8.21.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"commander": "^14.0.2",
		"fs-extra": "^11.3.3",
		"inquirer": "^13.1.0",
		"lucide-react": "^0.525.0",
		"maplibre-gl": "^5.24.0",
		"motion": "^12.40.0",
		"picocolors": "^1.1.1",
		"recharts": "^3.8.1",
		"sonner": "^2.0.6",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4.1.18",
		"tsx": "^4.21.0",
		"vaul": "^1.1.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@storybook/addon-docs": "^10.4.0",
		"@storybook/react-vite": "^10.4.0",
		"@types/fs-extra": "^11.0.4",
		"@types/inquirer": "^9.0.9",
		"@types/node": "^24.10.4",
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"eslint": "^9.39.1",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.24",
		"globals": "^16.5.0",
		"prettier": "^3.8.3",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"storybook": "^10.4.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.46.4",
		"vite": "^7.2.4",
		"vite-plugin-dts": "^4.5.4",
		"vite-plugin-lib-inject-css": "^2.2.2"
	}
}
